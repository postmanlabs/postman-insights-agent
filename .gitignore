# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
postman-insights-agent
bin/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# vim
*.swp

# IntelliJ
*.idea/**
*.iml

# Eclipse and VS Code's Java support (project files they generate)
.project
.classpath
.settings/
.factorypath

# Go mocks
*.mock.go
mock_*.go
mock/

# OSX
*.DS_Store

# bpf2go generated files (produced by `go generate ./ebpf/loader` at build time).
# These are arch-specific and regenerated by CI — do not commit.
ebpf/loader/*_bpfel.go
ebpf/loader/*_bpfeb.go
ebpf/loader/*.o

# Build output of the kind test services' Maven projects, which IDEs' Java
# support builds on its own.
test/kind/*/target/
