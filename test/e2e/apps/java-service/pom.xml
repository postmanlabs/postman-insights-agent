<?xml version="1.0" encoding="UTF-8"?>
<!-- Spring Boot (Tomcat) HTTPS service for Java HTTPS capture tests in kind. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.postman.insights.testapps</groupId>
  <artifactId>java-service</artifactId>
  <version>1.0.0</version>

  <properties>
    <java.version>21</java.version>
    <!-- Newer than what Spring Boot 4.1.1 manages (Tomcat 11.0.24, Jackson 3.1.5), for security fixes. -->
    <tomcat.version>11.0.27</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>java-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
